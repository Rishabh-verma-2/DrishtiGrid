# Dependencies
node_modules/
*/node_modules/

# Environment variables (Tracked for private repository multi-device deployment)
!.env
!server/.env
!client/.env
!ai-service/.env

# Production build outputs
dist/
build/
client/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/logs/*
!server/logs/.gitkeep

# Operating System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Python & AI Microservice
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
ai-service/venv/
ai-service/.venv/
.pytest_cache/
ai-service/model_weights/*.pt
ai-service/model_weights/*.pth
ai-service/*.pt
*.pt
server/data/
server/uploads/videos/*
!server/uploads/videos/.gitkeep
server/uploads/evidence/*
!server/uploads/evidence/.gitkeep
server/uploads/reports/*
!server/uploads/reports/.gitkeep
!ai-service/model_weights/.gitkeep
ai-service/temp/*
!ai-service/temp/.gitkeep

